{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["@vue-sudoku/sudoku-web"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": [{ "projects": ["@vue-sudoku/sudoku-web"], "target": "serve" }],
      "options": {
        "command": "pnpm exec tauri dev",
        "cwd": "apps/sudoku-desktop"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["@vue-sudoku/sudoku-web"], "target": "build" }],
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": [
        "{projectRoot}/src-tauri/target/release/sudoku.exe",
        "{projectRoot}/src-tauri/target/release/bundle"
      ],
      "options": {
        "command": "pnpm exec tauri build --no-bundle",
        "cwd": "apps/sudoku-desktop"
      },
      "configurations": {
        "installer": {
          "command": "pnpm exec tauri build"
        }
      }
    }
  }
}
