{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sudoku",
  "version": "../package.json",
  "identifier": "com.dimkontodin.sudoku",
  "build": {
    "frontendDist": "../../sudoku-web/dist",
    "devUrl": "http://localhost:4200"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sudoku",
        "width": 700,
        "height": 850,
        "minWidth": 450,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
