{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "out-tsc/playwright",
    "sourceMap": false,
    "types": ["node"],
    // page.evaluate() callbacks are compiled here but run in the browser, so
    // they need the DOM types even though the test process itself is Node.
    "lib": ["es2022", "dom"]
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "playwright.config.mts",
    "src/**/*.spec.ts",
    "src/**/*.spec.js",
    "src/**/*.test.ts",
    "src/**/*.test.js",
    "src/**/*.d.ts"
  ],
  "exclude": ["out-tsc", "test-output"]
}
