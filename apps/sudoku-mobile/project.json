{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@vue-sudoku/sudoku-mobile",
  "targets": {
    "cap-sync": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "pnpm exec cap sync",
        "cwd": "apps/sudoku-mobile"
      }
    },
    "android-bundle": {
      "executor": "nx:run-commands",
      "dependsOn": ["cap-sync"],
      "options": {
        "command": "node scripts/gradle.mjs bundleRelease",
        "cwd": "apps/sudoku-mobile"
      },
      "outputs": ["{projectRoot}/android/app/build/outputs/bundle/release"]
    },
    "android-apk": {
      "executor": "nx:run-commands",
      "dependsOn": ["cap-sync"],
      "options": {
        "command": "node scripts/gradle.mjs assembleRelease",
        "cwd": "apps/sudoku-mobile"
      },
      "outputs": ["{projectRoot}/android/app/build/outputs/apk/release"]
    },
    "open": {
      "executor": "nx:run-commands",
      "dependsOn": ["cap-sync"],
      "options": {
        "command": "echo \"Pass a platform, e.g. 'nx run sudoku-mobile:open:android'\" && exit 1",
        "cwd": "apps/sudoku-mobile"
      },
      "configurations": {
        "android": {
          "command": "pnpm exec cap open android",
          "cwd": "apps/sudoku-mobile"
        },
        "ios": {
          "command": "pnpm exec cap open ios",
          "cwd": "apps/sudoku-mobile"
        }
      }
    }
  }
}
